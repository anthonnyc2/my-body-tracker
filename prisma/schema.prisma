generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  ADMIN
  EVALUATOR
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PhysicalActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Goal {
  FAT_LOSS
  MUSCLE_GAIN
  BODY_RECOMPOSITION
  SPORTS_PERFORMANCE
  MAINTENANCE
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum EvaluationType {
  FULL
  SIMPLE
}

enum EvaluationPhotoType {
  FRONTAL
  POSTERIOR
  PROFILE_LEFT
  PROFILE_RIGHT
}

model User {
  id            String    @id @default(uuid()) // Links to Supabase Auth UUID
  email         String    @unique
  role          Role      @default(EVALUATOR)
  firstName     String
  lastName      String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  managedPatients Patient[]     @relation("EvaluatorToPatient")
  patientProfile  Patient?      @relation("UserToPatientProfile")
  subscription    Subscription?
  routines        Routine[]     @relation("EvaluatorToRoutine")
}

model Subscription {
  id                  String              @id @default(uuid())
  userId              String              @unique
  plan                SubscriptionPlan    @default(FREE)
  status              SubscriptionStatus  @default(ACTIVE)
  billingCycle        BillingCycle?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean             @default(false)

  // Placeholders for a future payment provider (e.g. Stripe) — unused until billing is built
  providerCustomerId     String? @unique
  providerSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Patient {
  id              String   @id @default(uuid())
  evaluatorId     String
  userId          String?  @unique // Si el paciente tiene cuenta de login
  
  firstName       String
  lastName        String
  gender          Gender
  birthDate       DateTime
  documentId      String?
  phone           String?
  email           String?
  address         String?
  
  initialWeight   Float
  height          Float
  activityLevel   PhysicalActivityLevel
  goal            Goal

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Compartir historial con paciente
  shareToken      String   @unique @default(uuid())
  viewCount       Int      @default(0)

  // Relaciones
  evaluator       User     @relation("EvaluatorToPatient", fields: [evaluatorId], references: [id])
  userProfile     User?    @relation("UserToPatientProfile", fields: [userId], references: [id])
  evaluations     Evaluation[]
  routines        Routine[]
}

model Evaluation {
  id              String   @id @default(uuid())
  patientId       String
  date            DateTime
  type            EvaluationType @default(FULL)
  decimalAge      Float?

  // Datos Generales
  weight          Float
  height          Float

  // Perímetros (cm)
  girthThorax     Float?
  girthAbdomen    Float?
  girthWaist      Float?
  girthHip        Float?
  girthRelaxedArm Float?
  girthFlexedArm  Float?
  girthForearm    Float?
  girthWrist      Float?
  girthThigh      Float?  // Muslo Medio
  girthMaxThigh   Float?  // Muslo Maximo
  girthCalf       Float?

  // Diámetros (cm)
  breadthHumerus  Float?
  breadthFemur    Float?
  breadthBistyl   Float?
  breadthBimal    Float?

  // Pliegues (mm)
  skinfoldTriceps Float?
  skinfoldSubscap Float?
  skinfoldBiceps  Float?
  skinfoldIliac   Float?
  skinfoldSuprasp Float?
  skinfoldAbdom   Float?
  skinfoldThigh   Float?
  skinfoldCalf    Float?

  // Resultados Calculados
  bmi             Float?
  bodyFatPct      Float?
  bodyFatKg       Float?
  muscleMassPct   Float?
  muscleMassKg    Float?
  boneMassKg      Float?
  residualMassKg  Float?
  fatFreeMass     Float?
  idealWeight     Float?

  // Metas Personalizadas
  targetBodyFatPct    Float?
  targetMuscleMassPct Float?

  // Compartir con paciente
  shareToken      String   @unique @default(uuid())
  viewCount       Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  photos          EvaluationPhoto[]
  recommendation  Recommendation?
}

model EvaluationPhoto {
  id            String              @id @default(uuid())
  evaluationId  String
  type          EvaluationPhotoType
  path          String              // Supabase Storage object key (private bucket, not a public URL)
  createdAt     DateTime            @default(now())

  evaluation    Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, type])
}

model Recommendation {
  id            String   @id @default(uuid())
  evaluationId  String   @unique
  observations  String?  @db.Text
  conclusions   String?  @db.Text
  recommendations String? @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evaluation    Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
}

model Exercise {
  id               String   @id // Id original del dataset de origen, para upserts idempotentes al re-seedear
  name             String
  nameEn           String   // Nombre original en inglés del dataset, solo para búsqueda bilingüe (no se muestra en la UI)
  category         String   // Parte del cuerpo / grupo muscular (string libre: vocabulario lo controla el dataset de origen)
  equipment        String?
  targetMuscle     String?
  secondaryMuscles String[] @default([])
  instructionsEs   String[] @default([])
  thumbnailUrl     String?
  gifUrl           String?
  sourceUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  routineDayExercises RoutineDayExercise[]

  @@index([category])
  @@index([equipment])
  @@index([targetMuscle])
  @@index([name])
  @@index([nameEn])
}

model Routine {
  id          String    @id @default(uuid())
  patientId   String
  evaluatorId String    // Denormalizado de patient.evaluatorId al crear, para checks de ownership sin joins extra
  name        String
  description String?
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  evaluator User         @relation("EvaluatorToRoutine", fields: [evaluatorId], references: [id])
  days      RoutineDay[]

  @@index([patientId])
  @@index([evaluatorId])
}

model RoutineDay {
  id        String  @id @default(uuid())
  routineId String
  order     Int     // Sort key manejado por la app (reescrito completo en cada guardado), sin constraint de unicidad
  label     String
  notes     String?

  routine   Routine              @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises RoutineDayExercise[]

  @@index([routineId, order])
}

model RoutineDayExercise {
  id           String  @id @default(uuid())
  routineDayId String
  exerciseId   String
  order        Int
  sets         Int?
  reps         String? // String y no Int: admite "8-12", "AMRAP", "al fallo"
  restSeconds  Int?
  notes        String?

  routineDay RoutineDay @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id])

  @@index([routineDayId, order])
  @@index([exerciseId])
}
